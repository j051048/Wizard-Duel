# Wizard Duel 环境变量配置
# 复制此文件为 .env.local 并填入实际值

# ============ 后端 API ============
# Zeabur 后端地址 (留空则使用 Mock 模式)
VITE_API_BASE_URL=

# 是否强制使用 Mock 模式 (true/false)
VITE_USE_MOCK=true

# ============ Supabase 配置 ============
# Supabase 项目 URL
VITE_SUPABASE_URL=

# Supabase 匿名密钥
VITE_SUPABASE_ANON_KEY=

# ============ 集成配置 ============
# 父应用通信密钥 (用于嵌入其他App时)
VITE_INTEGRATION_SECRET=

# ============ 功能开关 ============
# 启用调试模式
VITE_DEBUG=false

# 启用音效
VITE_ENABLE_AUDIO=true
